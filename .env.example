# Copy thành .env rồi điền. KHÔNG commit .env.

# --- Chọn cách dựng Ledger ---
# keyword : baseline lọc keyword (không cần key)
# replay  : luật chạy trên sự kiện đã lưu (demo m01–m25 không cần key)
# llm     : pipeline chính, LLM gán sự kiện + luật suy trạng thái;
#           cuộc họp có sự kiện đã lưu ở REPLAY_EVENTS_DIR thì replay, không gọi LLM
LEDGER_BUILDER=replay
# Output LLM đã lưu (gpt-4.1-mini, 14/10/2026) cho m01–m25 — tương đối với apps/api
REPLAY_EVENTS_DIR=demo_events

# --- Giới hạn cho demo công khai ---
MAX_TRANSCRIPT_CHARS=20000
# Chỉ tính request thật sự gọi LLM (transcript mẫu replay không bị tính)
LLM_RATE_LIMIT_PER_HOUR=10
LLM_GLOBAL_LIMIT_PER_HOUR=60

# --- LLM (chuẩn OpenAI-compatible) ---
# OpenAI:      LLM_BASE_URL=                                   LLM_MODEL=gpt-4.1-mini
# Gemini:      LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/   LLM_MODEL=gemini-2.5-flash
# OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1       LLM_MODEL=qwen/qwen3.6-27b
# Tự host:     LLM_BASE_URL=http://localhost:8001/v1 (vLLM)     LLM_MODEL=Qwen/Qwen3.6-27B
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini

# --- Sinh dữ liệu tổng hợp (nên KHÁC model ở trên) ---
GEN_BASE_URL=
GEN_API_KEY=
GEN_MODEL=

# --- Hạ tầng ---
DATABASE_URL=
CORS_ORIGINS=http://localhost:3000
